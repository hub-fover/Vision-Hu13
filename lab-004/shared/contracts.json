{
  "schemaVersion": "lab004.measurement.v1",
  "analysisMaxSide": 1280,
  "targetAnalysisFps": 30,
  "maxWorkingSetMiB": 320,
  "defaultMethod": "template",
  "speedMethod": "camera-speed",
  "minScaleLengthPx": 40,
  "minTemplateSizePx": 64,
  "minTemplateScore": 0.55,
  "maxCameraDriftPx": 1.5,
  "minSamplesForSpectrum": 128,
  "frequencyBandHz": [0.2, 12.0],
  "quality": {"stableConfidence": 0.8, "referenceConfidence": 0.5},
  "lengthUnit": "metre",
  "errorCodes": {
    "INVALID_FRAME": "Frame or image dimensions are invalid.",
    "UNSUPPORTED_FORMAT": "The input format is unsupported.",
    "DECODE_FAILED": "The input could not be decoded.",
    "INVALID_SCALE": "Two-point scale reference is invalid.",
    "TARGET_TOO_SMALL": "The target region is too small or outside the frame.",
    "LOW_TEXTURE": "The selected target has insufficient texture.",
    "LOW_CONTRAST": "The selected target has insufficient contrast.",
    "TEMPLATE_LOST": "Template matching lost the target.",
    "CAMERA_MOVED": "The fixed camera moved during capture.",
    "BACKGROUND_UNTRACKABLE": "The background cannot be used as a stability anchor.",
    "SCENE_CHANGED": "The scene changed beyond the supported motion model.",
    "FPS_UNSTABLE": "Frame timestamps are too irregular for spectrum analysis.",
    "INSUFFICIENT_SAMPLES": "More samples are required for spectrum analysis.",
    "RUNTIME_MISSING": "The local computer-vision runtime is unavailable.",
    "PERMISSION_DENIED": "Camera permission was denied.",
    "CANCELLED": "The operation was cancelled.",
    "VIDEO_RECORDING_UNSUPPORTED": "The browser cannot create a local result video.",
    "VIDEO_RECORDING_FAILED": "The local result video encoder failed.",
    "VIDEO_RECORDING_CANCELLED": "The result video recording was cancelled."
  },
  "types": {
    "ScaleReference": {"fields": {"p1Px": "[x,y]", "p2Px": "[x,y]", "realDistanceM": "positive number", "unit": "mm|cm|m"}},
    "TargetRegion": {"fields": {"xPx": "number", "yPx": "number", "widthPx": "positive number", "heightPx": "positive number"}},
    "MeasurementOptions": {"fields": {"method": "template|flow|dic|camera-speed", "fps": "positive number", "maxCameraDriftPx": "positive number", "minTemplateScore": "0..1"}},
    "TrackingSample": {"fields": {"frameIndex": "integer", "timeS": "number", "dxPx": "number", "dyPx": "number", "dxM": "number", "dyM": "number", "score": "number", "valid": "boolean", "errorCode": "error code|null"}},
    "DisplacementSeries": {"fields": {"samples": "TrackingSample[]", "peakToPeakM": "number", "rmsM": "number", "peakToPeakPx": "number"}},
    "SpectrumPeak": {"fields": {"frequencyHz": "number", "amplitude": "number", "prominence": "number"}},
    "MeasurementReport": {"fields": {"schemaVersion": "lab004.measurement.v1", "method": "template|flow|dic|camera-speed", "scale": "ScaleReference|null", "displacement": "DisplacementSeries", "spectrum": "SpectrumPeak|null", "velocity": "VelocitySummary|null", "diagnostics": "TrackingDiagnostics", "errors": "error code[]"}},
    "VelocitySample": {"fields": {"frameIndex": "integer", "timeS": "number", "vxMps": "number", "vyMps": "number", "speedMps": "number", "valid": "boolean", "errorCode": "error code|null"}},
    "VelocitySummary": {"fields": {"samples": "VelocitySample[]", "meanSpeedMps": "number", "peakSpeedMps": "number", "quality": "reference-only"}},
    "TrackingDiagnostics": {"fields": {"cameraStable": "boolean", "backgroundTrackable": "boolean", "validRatio": "number", "meanScore": "number", "fps": "number", "errorCode": "error code|null", "motionModel": "string|null", "inlierCount": "integer", "inlierRatio": "number", "medianReprojectionErrorPx": "number"}}
  }
}

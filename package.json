{
  "name": "perspective-paste-lab-001",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:web",
    "test:web": "node --test tests/web/*.test.js",
    "test:lab002": "npm run test:lab002:web && npm run test:lab002:python",
    "test:lab002:web": "npm --prefix lab-002/web run test",
    "test:lab002:python": "python -m pytest -c lab-002/pyproject.toml lab-002/tests/python",
    "test:lab002:acceptance": "python lab-002/scripts/validate_acceptance.py",
    "test:lab002:e2e": "npm --prefix lab-002/web run test:e2e",
    "build:lab002": "npm --prefix lab-002/web run build:pages",
    "validate:lab002:assets": "python lab-002/scripts/validate_public_assets.py",
    "validate:lab002:pages": "node lab-002/scripts/stage-pages.mjs --validate-only ../../web/lab-002",
    "validate:lab002:release": "npm run test:lab002:acceptance && npm run validate:lab002:assets && npm run validate:lab002:pages",
    "test:lab003": "npm run test:lab003:web && npm run test:lab003:python",
    "test:lab003:web": "npm --prefix lab-003/web run test",
    "test:lab003:python": "python -m pytest -c lab-003/pyproject.toml lab-003/tests/python",
    "test:lab003:acceptance": "python lab-003/scripts/validate_acceptance.py",
    "test:lab003:e2e": "node node_modules/@playwright/test/cli.js test -c lab-003/playwright.config.js",
    "build:lab003": "npm --prefix lab-003/web run build:pages",
    "validate:lab003:pages": "node lab-003/scripts/stage-pages.mjs --validate-only ../../web/lab-003",
    "validate:lab003:release": "npm run test:lab003:acceptance && npm run validate:lab003:pages",
    "test:lab004": "npm run test:lab004:web && npm run test:lab004:python",
    "test:lab004:web": "npm --prefix lab-004/web run test",
    "test:lab004:python": "python -m pytest -c lab-004/pyproject.toml lab-004/tests/python",
    "test:lab004:e2e": "npm --prefix lab-004/web run test:e2e",
    "build:lab004": "npm --prefix lab-004/web run build:pages",
    "validate:lab004:pages": "node lab-004/scripts/stage-pages.mjs --validate-only ../../web/lab-004",
    "test:lab004:acceptance": "python lab-004/scripts/validate_acceptance.py",
    "test:lab004:cross-runtime": "node lab-004/scripts/cross_runtime_web.mjs",
    "validate:lab004:assets": "python lab-004/scripts/validate_public_assets.py",
    "validate:lab004:release": "npm run test:lab004 && npm run test:lab004:e2e && npm run test:lab004:cross-runtime && npm run test:lab004:acceptance && npm run validate:lab004:assets && npm run validate:lab004:pages",
    "test:lab005": "npm run test:lab005:python && npm run test:lab005:web",
    "test:lab005:python": "python -m pytest -c lab-005/pyproject.toml lab-005/tests/python",
    "test:lab005:web": "npm --prefix lab-005/web test",
    "test:lab005:e2e": "npm --prefix lab-005/web run test:e2e",
    "test:lab005:acceptance": "python lab-005/scripts/validate_acceptance.py",
    "test:lab005:cross-runtime": "node lab-005/scripts/cross_runtime_web.mjs",
    "validate:lab005:assets": "python lab-005/scripts/validate_public_assets.py",
    "generate:lab005:samples": "node lab-005/scripts/generate_focus_samples.mjs",
    "build:lab005": "npm --prefix lab-005/web run vendor:opencv && node lab-005/scripts/stage-pages.mjs",
    "validate:lab005:pages": "node lab-005/scripts/stage-pages.mjs --validate-only ../../web/lab-005",
    "validate:lab005:release": "npm run test:lab005 && npm run test:lab005:e2e && npm run test:lab005:cross-runtime && npm run test:lab005:acceptance && npm run validate:lab005:assets && npm run validate:lab005:pages",
    "build:lab006": "python lab-006/scripts/build.py && node lab-006/scripts/stage-pages.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:web && npm run test:e2e",
    "record:demo": "node scripts/record_demo.mjs",
    "serve": "node scripts/serve_web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}

{
  "name": "panorama-stitch-lab-002-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run vendor:opencv",
    "test": "node --test ../tests/web/*.test.js",
    "pretest:e2e": "npm run vendor:opencv",
    "test:e2e": "playwright test -c ../playwright.config.js",
    "vendor:opencv": "node ../scripts/vendor-opencv.mjs",
    "build:pages": "npm run vendor:opencv && node ../scripts/stage-pages.mjs ../../web/lab-002",
    "validate:pages": "node ../scripts/stage-pages.mjs --validate-only ../../web/lab-002"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1"
  }
}
